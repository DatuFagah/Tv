<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MY TV Malaysia</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #080808;
    color: white;
    font-family: Arial, sans-serif;
}

/* TV */

.tv-area {
    min-height: 100vh;
    padding: 25px 15px 50px;
}

.tv {
    max-width: 1000px;
    margin: auto;
}

/* TV FRAME */

.tv-frame {
    background: linear-gradient(145deg,#303030,#111);
    border: 12px solid #222;
    border-radius: 30px;
    padding: 18px;
    box-shadow:
        0 0 0 5px #444,
        0 25px 60px rgba(0,0,0,.8);
}

/* SCREEN */

.screen {
    position: relative;
    background: #000;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
}

.screen iframe {
    width: 100%;
    height: 100%;
    border: 0;
}

/* LIVE */

.live {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 5;
    background: #e60000;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: bold;
}

/* CHANNEL NAME */

.channel-title {
    background: #111;
    padding: 13px;
    font-size: 18px;
    font-weight: bold;
}

/* TV BOTTOM */

.tv-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 8px 2px;
}

.brand {
    font-weight: bold;
    font-size: 18px;
}

.brand span {
    color: #00bfff;
}

.power {
    width: 12px;
    height: 12px;
    background: #e60000;
    border-radius: 50%;
    box-shadow: 0 0 12px red;
}

/* CHANNELS */

.channels {
    max-width: 1000px;
    margin: 30px auto 0;
}

.channels h2 {
    margin-bottom: 15px;
}

.grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fit,minmax(140px,1fr));
    gap: 12px;
}

.channel {
    background: #161616;
    border: 1px solid #292929;
    border-radius: 12px;
    padding: 18px 10px;
    text-align: center;
    cursor: pointer;
    transition: .2s;
}

.channel:hover {
    transform: translateY(-3px);
    border-color: #00bfff;
    background: #202020;
}

.channel.active {
    border-color: #00bfff;
    box-shadow: 0 0 15px rgba(0,191,255,.25);
}

.logo {
    font-size: 30px;
    margin-bottom: 8px;
}

.name {
    font-weight: bold;
}

.status {
    display: inline-block;
    margin-top: 8px;
    font-size: 10px;
    background: #d90000;
    padding: 4px 7px;
    border-radius: 4px;
}

.info {
    max-width: 1000px;
    margin: 25px auto;
    color: #888;
    font-size: 13px;
    text-align: center;
}

@media(max-width:600px) {

    .tv-area {
        padding: 10px 5px 30px;
    }

    .tv-frame {
        border-width: 7px;
        border-radius: 18px;
        padding: 8px;
    }

    .grid {
        grid-template-columns: repeat(2,1fr);
    }
}
</style>
</head>

<body>

<div class="tv-area">

<div class="tv">

    <!-- TV FRAME -->

    <div class="tv-frame">

        <div class="screen">

            <div class="live">
                ● LIVE
            </div>

            <iframe
                id="player"
                src="https://rtmklik.rtm.gov.my/live/tv/tv1"
                allow="autoplay; fullscreen"
                allowfullscreen>
            </iframe>

        </div>

        <div class="channel-title" id="channelTitle">
            🇲🇾 TV1
        </div>

        <div class="tv-bottom">

            <div class="brand">
                MY <span>TV</span>
            </div>

            <div class="power"></div>

        </div>

    </div>


    <!-- CHANNEL LIST -->

    <div class="channels">

        <h2>📺 Saluran Malaysia</h2>

        <div class="grid">


            <div class="channel active"
                onclick="watch(
                'TV1',
                'https://rtmklik.rtm.gov.my/live/tv/tv1',
                this)">

                <div class="logo">🇲🇾</div>
                <div class="name">TV1</div>
                <div class="status">LIVE</div>

            </div>


            <div class="channel"
                onclick="watch(
                'TV2',
                'https://rtmklik.rtm.gov.my/live/tv/tv2',
                this)">

                <div class="logo">🇲🇾</div>
                <div class="name">TV2</div>
                <div class="status">LIVE</div>

            </div>


            <div class="channel"
                onclick="watch(
                'TV OKEY',
                'https://rtmklik.rtm.gov.my/live/tv/okey',
                this)">

                <div class="logo">🇲🇾</div>
                <div class="name">TV OKEY</div>
                <div class="status">LIVE</div>

            </div>


            <div class="channel"
                onclick="watch(
                'BERITA RTM',
                'https://rtmklik.rtm.gov.my/live/tv/berita',
                this)">

                <div class="logo">📰</div>
                <div class="name">BERITA RTM</div>
                <div class="status">LIVE</div>

            </div>


            <div class="channel"
                onclick="watch(
                'TV SUKAN',
                'https://rtmklik.rtm.gov.my/live/tv/sukan',
                this)">

                <div class="logo">⚽</div>
                <div class="name">TV SUKAN</div>
                <div class="status">LIVE</div>

            </div>


            <div class="channel"
                onclick="watch(
                'TV6',
                'https://rtmklik.rtm.gov.my/live/tv/tv6',
                this)">

                <div class="logo">📺</div>
                <div class="name">TV6</div>
                <div class="status">LIVE</div>

            </div>


            <div class="channel"
                onclick="watch(
                'TV3',
                'https://browse.tonton.com.my/live',
                this,
                true)">

                <div class="logo">📺</div>
                <div class="name">TV3</div>
                <div class="status">OFFICIAL</div>

            </div>


            <div class="channel"
                onclick="watch(
                'NTV7',
                'https://browse.tonton.com.my/live',
                this,
                true)">

                <div class="logo">📺</div>
                <div class="name">NTV7</div>
                <div class="status">OFFICIAL</div>

            </div>


            <div class="channel"
                onclick="watch(
                '8TV',
                'https://browse.tonton.com.my/live',
                this,
                true)">

                <div class="logo">📺</div>
                <div class="name">8TV</div>
                <div class="status">OFFICIAL</div>

            </div>


            <div class="channel"
                onclick="watch(
                'TV9',
                'https://browse.tonton.com.my/live',
                this,
                true)">

                <div class="logo">📺</div>
                <div class="name">TV9</div>
                <div class="status">OFFICIAL</div>

            </div>

        </div>

    </div>


    <div class="info">
        Siaran disediakan melalui platform rasmi penyiar.
    </div>

</div>

</div>


<script>

function watch(name, url, element, external = false) {

    document
        .querySelectorAll(".channel")
        .forEach(function(item) {
            item.classList.remove("active");
        });

    element.classList.add("active");

    document
        .getElementById("channelTitle")
        .innerHTML = "🇲🇾 " + name;

    if (external) {

        window.open(url, "_blank");

    } else {

        document
            .getElementById("player")
            .src = url;

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    }

}

</script>

</body>
</html>
